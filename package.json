{
  "name": "quick-vint",
  "version": "1.0.0",
  "description": "",
  "main": "content.js",
  "scripts": {
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test test/*.test.js",
    "test:e2e": "playwright test",
    "test:ci": "npm run test:unit && npm run test:e2e && npm run build:prod",
    "test:e2e:install": "playwright install chromium",
    "verify:production": "npm test && npm run build:prod",
    "push:production": "bash scripts/push-production.sh",
    "build": "node scripts/set-env.js && terser content.js -o content.min.js --compress --mangle",
    "build:prod": "API_BASE_URL=https://autolister.app node scripts/set-env.js && terser content.js -o content.min.js --compress --mangle",
    "build:local": "API_BASE_URL=http://localhost:5000 node scripts/set-env.js && terser content.js -o content.min.js --compress --mangle",
    "prepare": "npm run build",
    "release:status": "node scripts/release-version.js status",
    "release:check": "node scripts/release-version.js check",
    "release:bump": "node scripts/release-version.js bump-patch",
    "release:mark-uploaded": "node scripts/release-version.js mark-uploaded",
    "release:mark-published": "node scripts/release-version.js mark-published",
    "release:clear-pending": "node scripts/release-version.js clear-pending",
    "release:chrome-web-store": "node scripts/chrome-web-store-release.js",
    "canary:dom": "node scripts/run-dom-canary.mjs",
    "canary:dom:check": "DOM_CANARY_NO_POST=1 node scripts/run-dom-canary.mjs",
    "canary:dom:setup": "DOM_CANARY_HEADED=1 DOM_CANARY_NO_POST=1 DOM_CANARY_KEEP_OPEN_MS=600000 node scripts/run-dom-canary.mjs",
    "live:session": "node scripts/create-live-test-session.mjs",
    "test:live:wardrobe": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$(wslpath -w scripts/run-live-wardrobe-rewrite.ps1)\"",
    "package": "node build.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samicodesit/quick-vint-frontend.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/samicodesit/quick-vint-frontend/issues"
  },
  "homepage": "https://github.com/samicodesit/quick-vint-frontend#readme",
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "terser": "^5.39.2"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.8"
  }
}
